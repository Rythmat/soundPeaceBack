# Name of your Google Cloud Storage bucket (just the name, no gs:// prefix)
GCS_BUCKET=sound-bites

PORT=3000

# Comma-separated origins of the frontend allowed to call this API (no trailing slash).
# Defaults to the local frontend dev server. On Render, set it to the static site's URL.
ALLOWED_ORIGINS=http://localhost:5173

# Optional: path to a service account key JSON. If unset, Application Default
# Credentials are used (run `gcloud auth application-default login` locally).
# On Render, add the key as a Secret File and use /etc/secrets/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
